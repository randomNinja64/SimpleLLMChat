<Application x:Class="SimpleLLMChatGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <!-- Dynamic brush for button text color -->
        <SolidColorBrush x:Key="ButtonTextColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}"/>

        <!-- Dynamic brush for chat background color -->
        <SolidColorBrush x:Key="ChatBackgroundColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}"/>

        <!-- Dynamic brush for label text color -->
        <SolidColorBrush x:Key="LabelTextColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.ControlTextColorKey}}"/>

        <!-- Dynamic brush for chat text color -->
        <SolidColorBrush x:Key="ChatTextColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}"/>

        <!-- Dynamic brush for window background color -->
        <SolidColorBrush x:Key="WindowBackgroundColorBrush"
                         Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>

        <!-- ===================== -->
        <!-- GLOBAL CONTROL STYLES -->
        <!-- ===================== -->

        <!-- Buttons -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextColorBrush}"/>
        </Style>

        <!-- ToggleButtons -->
        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextColorBrush}"/>
        </Style>

        <!-- RichTextBoxes -->
        <Style TargetType="RichTextBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ChatBackgroundColorBrush}"/>
        </Style>

        <!-- TextBoxes -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ChatBackgroundColorBrush}"/>
        </Style>

        <!-- PasswordBoxes -->
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ChatBackgroundColorBrush}"/>
        </Style>

        <!-- ListBoxes -->
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
        </Style>

        <!-- CheckBoxes -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ChatTextColorBrush}"/>
        </Style>

        <!-- Labels -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource LabelTextColorBrush}"/>
        </Style>

    </Application.Resources>
</Application>
