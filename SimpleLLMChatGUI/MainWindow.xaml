<Window x:Class="SimpleLLMChatGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple LLM Chat" Height="350" Width="450" Loaded="Window_Loaded"
        MinWidth="415" MinHeight="200"
        Background="{DynamicResource WindowBackgroundColorBrush}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Top row: buttons -->
            <RowDefinition Height="*" />
            <!-- Chat output -->
            <RowDefinition Height="58" />
            <!-- Chat input + button (2 button rows + padding) -->
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Desktop Assistant -->
            <ToggleButton Name="desktopAssistantToggle"
                          Content="Desktop Assistant"
                          ToolTip="Ctrl+Shift+D — capture a screenshot and ask about it. Requires a vision-capable model."
                          Padding="8,0"
                          Height="25"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          Grid.Column="0" />

            <!-- Center: Reasoning Effort -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Reasoning:"
                           Foreground="{DynamicResource LabelTextColorBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox Name="reasoningEffortComboBox"
                          Height="25"
                          MinWidth="110"
                          VerticalAlignment="Center"
                          SelectionChanged="reasoningEffortComboBox_SelectionChanged" />
            </StackPanel>

            <!-- Right: Options -->
            <Button Name="optionsButton"
                    Content="Options"
                    Width="80"
                    Height="25"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Grid.Column="2"
                    Click="optionsButton_Click" />
        </Grid>

        <!-- Chat history -->
        <RichTextBox Name="chatOutput"
                     Grid.Row="1"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch"
                     Margin="0,0,0,5"
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto">
            <RichTextBox.Resources>
                <Style TargetType="Paragraph">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>

        <!-- Bottom bar: two 25px button rows with padding -->
        <Grid Grid.Row="2" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!-- New Chat + attach -->
                <ColumnDefinition Width="*" />
                <!-- Input expands -->
                <ColumnDefinition Width="Auto" />
                <!-- Send button -->
            </Grid.ColumnDefinitions>

            <!-- Bottom left: Clear Chat aligned to input top, image button to input bottom -->
            <Grid Grid.Column="0"
                  Width="80"
                  Margin="0,0,5,0"
                  VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Name="clearButton"
                        Grid.Row="0"
                        Content="Clear Chat"
                        Height="25"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Click="clearButton_Click" />

                <ToggleButton Name="attachButton"
                              Grid.Row="2"
                              Height="25"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Stretch"
                              ToolTip="Attach Image (if supported by model)"
                              Checked="attachButton_Checked"
                              Unchecked="attachButton_Unchecked">
                    <Image Source="pack://application:,,,/Resources/photoframe.png"
                           Width="20" Height="20" Stretch="Uniform"/>
                </ToggleButton>
            </Grid>

            <TextBox Name="chatInput"
                     Grid.Column="1"
                     VerticalAlignment="Stretch"
                     Margin="0,0,5,0"
                     HorizontalAlignment="Stretch"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="chatInput_PreviewKeyDown" />

            <Button Name="sendButton"
                    Grid.Column="2"
                    Content="Send"
                    Width="60"
                    VerticalAlignment="Stretch"
                    Click="sendButton_Click" />
        </Grid>
    </Grid>
</Window>
