<Window x:Class="SimpleLLMChatGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimpleLLMChatGUI"
        Title="Simple LLM Chat" Height="350" Width="450" Loaded="Window_Loaded"
        MinWidth="415" MinHeight="200"
        Background="{DynamicResource WindowBackgroundColorBrush}">
    <Window.Resources>
        <!-- +/- toggle for collapsible thinking / tool-call blocks -->
        <Style x:Key="ThinkingExpandToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Width="9" Height="9"
                                    BorderBrush="{TemplateBinding Foreground}"
                                    BorderThickness="1"
                                    Background="Transparent"
                                    Margin="0,1,5,0"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Rectangle x:Name="Horizontal"
                                               Width="5" Height="1"
                                               Fill="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Rectangle x:Name="Vertical"
                                               Width="1" Height="5"
                                               Fill="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Vertical" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinkingExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="False">
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          Style="{StaticResource ThinkingExpandToggleStyle}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{TemplateBinding Header}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Left"
                                          Padding="0"/>
                            <ContentPresenter x:Name="ExpandSite"
                                              DockPanel.Dock="Top"
                                              ContentSource="Content"
                                              Visibility="Collapsed"
                                              Margin="0"
                                              VerticalAlignment="Top"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Top row: buttons -->
            <RowDefinition Height="*" />
            <!-- Chat output -->
            <RowDefinition Height="Auto" />
            <!-- Chat input + button -->
            <RowDefinition Height="Auto" />
            <!-- Token status bar -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- History sidebar: width set in code (0 when closed, else the saved width) -->
            <ColumnDefinition Name="historyColumn" Width="0" />
            <!-- Drag handle between sidebar and chat -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="150" />
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ToggleButton Name="historyButton"
                              AutomationProperties.AutomationId="historyButton"
                              AutomationProperties.Name="History"
                              ToolTip="History"
                              MinWidth="30"
                              MinHeight="25"
                              Margin="0,0,5,0"
                              VerticalAlignment="Center"
                              Checked="historyButton_Toggled"
                              Unchecked="historyButton_Toggled">
                    <Image Source="pack://application:,,,/Resources/history.png"
                           Width="16" Height="16" Stretch="Uniform"/>
                </ToggleButton>
                <Button Name="newChatButton"
                        Content="New Chat"
                        MinWidth="80"
                        MinHeight="25"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Click="newChatButton_Click" />
            </StackPanel>

            <Button Name="optionsButton"
                    Content="Options"
                    MinWidth="80"
                    MinHeight="25"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Grid.Column="1"
                    Click="optionsButton_Click" />
        </Grid>

        <!-- History sidebar: saved sessions, newest first. Opening it narrows the
             chat column, which reflows turns as a window resize does. -->
        <Grid Name="historyPanel"
              Grid.Row="1"
              Grid.RowSpan="2"
              Grid.Column="0"
              Margin="0,0,0,2"
              Visibility="Collapsed">
            <ListBox Name="historyList"
                     AutomationProperties.AutomationId="historyList"
                     BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     Background="{DynamicResource ChatBackgroundColorBrush}"
                     Foreground="{DynamicResource ChatTextColorBrush}"
                     KeyDown="historyList_KeyDown"
                     ContextMenuOpening="historyList_ContextMenuOpening">
                <!-- Items are added when it opens (see historyList_ContextMenuOpening). -->
                <ListBox.ContextMenu>
                    <ContextMenu/>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,3"/>
                        <Setter Property="ToolTip" Value="{Binding Title}"/>
                        <EventSetter Event="MouseLeftButtonUp" Handler="historyItem_MouseLeftButtonUp"/>
                        <!-- Own template: the theme's selection highlight fades when the list
                             loses focus. The open chat (IsCurrent) is highlighted always;
                             hover and the keyboard selection get a faint tint. -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid SnapsToDevicePixels="True">
                                        <Border x:Name="Tint"
                                                Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                                Opacity="0.2"
                                                Visibility="Collapsed"/>
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Tint" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Tint" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ChatHistoryEntry}">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Name="historyEmptyText"
                       Text="(empty)"
                       Margin="8"
                       TextWrapping="Wrap"
                       Opacity="0.65"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource ChatTextColorBrush}"/>
        </Grid>

        <!-- Drags the sidebar's width. ShowsPreview applies it once on release:
             each width change reflows every chat turn. -->
        <GridSplitter Name="historySplitter"
                      Grid.Row="1"
                      Grid.RowSpan="2"
                      Grid.Column="1"
                      Width="5"
                      Margin="0,0,0,2"
                      HorizontalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      ShowsPreview="True"
                      Focusable="False"
                      Background="Transparent"
                      Visibility="Collapsed"
                      DragStarted="historySplitter_DragStarted"
                      DragCompleted="historySplitter_DragCompleted" />

        <!-- Chat history: one ListBox item per turn -->
        <ListBox Name="chatList"
                 AutomationProperties.AutomationId="chatList"
                 Grid.Row="1"
                 Grid.Column="2"
                 Margin="0,0,0,5"
                 Padding="4"
                 BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch"
                 Background="{DynamicResource ChatBackgroundColorBrush}"
                 Foreground="{DynamicResource ChatTextColorBrush}"
                 SizeChanged="chatList_SizeChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin"
                            Value="{Binding ChatTurnItemMargin, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ChatTurn}">
                    <local:ChatTurnView Turn="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom bar: attach + input + send -->
        <Grid Grid.Row="2" Grid.Column="2" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton Name="attachButton"
                          Grid.Column="0"
                          MinWidth="45"
                          MinHeight="40"
                          Margin="0,0,5,0"
                          VerticalAlignment="Stretch"
                          ToolTip="Attach Image (if supported by model)"
                          Checked="attachButton_Checked"
                          Unchecked="attachButton_Unchecked">
                <Image Source="pack://application:,,,/Resources/photoframe.png"
                       Width="20" Height="20" Stretch="Uniform"/>
            </ToggleButton>

            <TextBox Name="chatInput"
                     AutomationProperties.AutomationId="chatInput"
                     Grid.Column="1"
                     MinHeight="40"
                     MaxHeight="100"
                     VerticalAlignment="Stretch"
                     Margin="0,0,5,0"
                     HorizontalAlignment="Stretch"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="chatInput_PreviewKeyDown" />

            <Button Name="sendButton"
                    AutomationProperties.AutomationId="sendButton"
                    Grid.Column="2"
                    Content="Send"
                    MinWidth="60"
                    MinHeight="40"
                    VerticalAlignment="Stretch"
                    Click="sendButton_Click" />
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="3" Grid.ColumnSpan="3" Margin="0" Padding="0"
                   Background="Transparent"
                   Foreground="{DynamicResource LabelTextColorBrush}"
                   FontFamily="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontFamily}"
                   FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0" Padding="0" Margin="0" HorizontalAlignment="Left">
                <TextBlock Cursor="Hand"
                           MouseLeftButtonUp="reasoningEffortLabel_MouseLeftButtonUp">
                    <Run Text="Reasoning: "/>
                    <Run x:Name="reasoningEffortLabel"
                         Text="Default"
                         TextDecorations="Underline"/>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" Padding="0" Margin="0" HorizontalAlignment="Right">
                <TextBlock Name="tokenStatusText"
                           AutomationProperties.AutomationId="tokenStatusText"
                           Text="Tokens: ~0" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
