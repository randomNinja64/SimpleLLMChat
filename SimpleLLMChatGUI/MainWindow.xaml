<Window x:Class="SimpleLLMChatGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimpleLLMChatGUI"
        Title="Simple LLM Chat" Height="350" Width="450" Loaded="Window_Loaded"
        MinWidth="415" MinHeight="200"
        Background="{DynamicResource WindowBackgroundColorBrush}">
    <Window.Resources>
        <!-- +/- toggle for collapsible thinking / tool-call blocks -->
        <Style x:Key="ThinkingExpandToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Width="9" Height="9"
                                    BorderBrush="{TemplateBinding Foreground}"
                                    BorderThickness="1"
                                    Background="Transparent"
                                    Margin="0,1,5,0"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Rectangle x:Name="Horizontal"
                                               Width="5" Height="1"
                                               Fill="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Rectangle x:Name="Vertical"
                                               Width="1" Height="5"
                                               Fill="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Vertical" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinkingExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="True">
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          Style="{StaticResource ThinkingExpandToggleStyle}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{TemplateBinding Header}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Left"
                                          Padding="0"/>
                            <ContentPresenter x:Name="ExpandSite"
                                              ContentSource="Content"
                                              Visibility="Collapsed"
                                              Margin="0"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Top row: buttons -->
            <RowDefinition Height="*" />
            <!-- Chat output -->
            <RowDefinition Height="Auto" />
            <!-- Chat input + button -->
            <RowDefinition Height="Auto" />
            <!-- Token status bar -->
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Clear Chat -->
            <Button Name="clearButton"
                    Content="Clear Chat"
                    Width="80"
                    Height="25"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Grid.Column="0"
                    Click="clearButton_Click" />

            <!-- Center: Desktop Assistant -->
            <ToggleButton Name="desktopAssistantToggle"
                          Content="Desktop Assistant"
                          ToolTip="Ctrl+Shift+D — capture a screenshot and ask about it. Requires a vision-capable model."
                          Padding="8,0"
                          Height="25"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Grid.Column="1" />

            <!-- Right: Options -->
            <Button Name="optionsButton"
                    Content="Options"
                    Width="80"
                    Height="25"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Grid.Column="2"
                    Click="optionsButton_Click" />
        </Grid>

        <!-- Chat history: one ListBox item per turn -->
        <ListBox Name="chatList"
                 Grid.Row="1"
                 Margin="0,0,0,5"
                 Padding="4"
                 BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch"
                 Background="{DynamicResource ChatBackgroundColorBrush}"
                 Foreground="{DynamicResource ChatTextColorBrush}"
                 SizeChanged="chatList_SizeChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,14"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ChatTurn}">
                    <RichTextBox IsReadOnly="True"
                                 IsUndoEnabled="False"
                                 IsDocumentEnabled="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource ChatTextColorBrush}"
                                 VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Disabled"
                                 local:ChatMessageDocumentBehavior.Document="{Binding Document}">
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom bar: attach + input + send -->
        <Grid Grid.Row="2" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton Name="attachButton"
                          Grid.Column="0"
                          Width="45"
                          Height="40"
                          Margin="0,0,5,0"
                          VerticalAlignment="Bottom"
                          ToolTip="Attach Image (if supported by model)"
                          Checked="attachButton_Checked"
                          Unchecked="attachButton_Unchecked">
                <Image Source="pack://application:,,,/Resources/photoframe.png"
                       Width="20" Height="20" Stretch="Uniform"/>
            </ToggleButton>

            <TextBox Name="chatInput"
                     Grid.Column="1"
                     Height="40"
                     MinHeight="25"
                     MaxHeight="100"
                     VerticalAlignment="Bottom"
                     Margin="0,0,5,0"
                     HorizontalAlignment="Stretch"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="chatInput_PreviewKeyDown" />

            <Button Name="sendButton"
                    Grid.Column="2"
                    Content="Send"
                    Width="60"
                    Height="40"
                    VerticalAlignment="Bottom"
                    Click="sendButton_Click" />
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="3" Margin="0" Padding="0"
                   Background="Transparent"
                   Foreground="{DynamicResource LabelTextColorBrush}"
                   FontFamily="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontFamily}"
                   FontSize="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FontSize}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0" Padding="0" Margin="0" HorizontalAlignment="Left">
                <TextBlock Cursor="Hand"
                           MouseLeftButtonUp="reasoningEffortLabel_MouseLeftButtonUp">
                    <Run Text="Reasoning: "/>
                    <Run x:Name="reasoningEffortLabel"
                         Text="Default"
                         TextDecorations="Underline"/>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" Padding="0" Margin="0" HorizontalAlignment="Right">
                <TextBlock Name="tokenStatusText"
                           Text="Tokens: ~0" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
