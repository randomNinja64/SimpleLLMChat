<Window x:Class="SimpleLLMChatGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple LLM Chat" Height="350" Width="450" Loaded="Window_Loaded"
        MinWidth="415" MinHeight="200"
        Background="{DynamicResource WindowBackgroundColorBrush}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Top row: buttons -->
            <RowDefinition Height="*" />
            <!-- Chat output -->
            <RowDefinition Height="58" />
            <!-- Chat input + button (2 button rows + padding) -->
            <RowDefinition Height="Auto" />
            <!-- Token status bar -->
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Clear Chat -->
            <Button Name="clearButton"
                    Content="Clear Chat"
                    Width="80"
                    Height="25"
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Grid.Column="0"
                    Click="clearButton_Click" />

            <!-- Center: Desktop Assistant -->
            <ToggleButton Name="desktopAssistantToggle"
                          Content="Desktop Assistant"
                          ToolTip="Ctrl+Shift+D — capture a screenshot and ask about it. Requires a vision-capable model."
                          Padding="8,0"
                          Height="25"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Grid.Column="1" />

            <!-- Right: Options -->
            <Button Name="optionsButton"
                    Content="Options"
                    Width="80"
                    Height="25"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Grid.Column="2"
                    Click="optionsButton_Click" />
        </Grid>

        <!-- Chat history -->
        <RichTextBox Name="chatOutput"
                     Grid.Row="1"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch"
                     Margin="0,0,0,5"
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto">
            <RichTextBox.Resources>
                <Style TargetType="Paragraph">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>

        <!-- Bottom bar: attach + input + send -->
        <Grid Grid.Row="2" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton Name="attachButton"
                          Grid.Column="0"
                          Width="45"
                          Margin="0,0,5,0"
                          VerticalAlignment="Stretch"
                          ToolTip="Attach Image (if supported by model)"
                          Checked="attachButton_Checked"
                          Unchecked="attachButton_Unchecked">
                <Image Source="pack://application:,,,/Resources/photoframe.png"
                       Width="20" Height="20" Stretch="Uniform"/>
            </ToggleButton>

            <TextBox Name="chatInput"
                     Grid.Column="1"
                     VerticalAlignment="Stretch"
                     Margin="0,0,5,0"
                     HorizontalAlignment="Stretch"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="chatInput_PreviewKeyDown" />

            <Button Name="sendButton"
                    Grid.Column="2"
                    Content="Send"
                    Width="60"
                    VerticalAlignment="Stretch"
                    Click="sendButton_Click" />
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="3" Margin="0" Padding="0"
                   Background="Transparent"
                   Foreground="{DynamicResource LabelTextColorBrush}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0" Padding="0" Margin="0" HorizontalAlignment="Left">
                <TextBlock FontSize="11"
                           Cursor="Hand"
                           MouseLeftButtonUp="reasoningEffortLabel_MouseLeftButtonUp">
                    <Run Text="Reasoning: "/>
                    <Run x:Name="reasoningEffortLabel"
                         Text="Default"
                         TextDecorations="Underline"/>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" Padding="0" Margin="0" HorizontalAlignment="Right">
                <TextBlock Name="tokenStatusText"
                           Text="Tokens: ~0"
                           FontSize="11" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
