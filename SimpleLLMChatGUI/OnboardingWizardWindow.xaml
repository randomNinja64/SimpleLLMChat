<Window x:Class="SimpleLLMChatGUI.OnboardingWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimpleLLMChat Setup"
        Height="340"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundColorBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Background="{DynamicResource WindowBackgroundColorBrush}"
                    Margin="14,10,14,8">
            <TextBlock x:Name="TitleText"
                       Text="Getting Started"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="{DynamicResource LabelTextColorBrush}"/>
            <TextBlock Text="These settings are required to connect to an LLM. More options are available in Options."
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource LabelTextColorBrush}"
                       Opacity="0.75"/>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{x:Static SystemColors.ControlDarkBrush}"/>

        <!-- System fields -->
        <ScrollViewer Grid.Row="2"
                      Margin="10,4,10,4"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,0,8,8">

                <Label Content="API Key:"/>
                <PasswordBox x:Name="ApiKeyPasswordBox" Height="23"/>

                <Label Content="LLM Server URL (http://ip:port):"/>
                <TextBox x:Name="ServerTextBox" Height="23"/>

                <Label Content="Model:"/>
                <TextBox x:Name="ModelTextBox" Height="23"/>

                <Label Content="Context Window Size (tokens):"/>
                <TextBox x:Name="ContextWindowSizeTextBox" Height="23"/>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Height="1" Background="{x:Static SystemColors.ControlDarkBrush}"/>

        <!-- Footer -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10,8,10,10">
            <Button x:Name="FinishButton"
                    Content="Finish"
                    Width="75"
                    Height="23"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="FinishButton_Click"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="75"
                    Height="23"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
