<Window x:Class="SimpleLLMChatGUI.ColorsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Colors"
        Height="320"
        Width="360"
        MinHeight="320"
        MinWidth="360"
        MaxWidth="360"
        MaxHeight="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Background="{DynamicResource WindowBackgroundColorBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ColorRows" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="{Binding Label}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Choose" Height="23"
                                    Margin="0,0,8,0" Click="ChooseColorButton_Click"/>
                            <Button Grid.Column="2" Content="Clear" Height="23"
                                    Margin="0,0,8,0" Click="ClearColorButton_Click"/>
                            <Border Grid.Column="3" Background="{Binding PreviewBrush}"
                                    Width="50" Height="23" BorderBrush="Gray"
                                    BorderThickness="1" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="OK" Width="75" Height="23"
                    Margin="0,0,8,0" Click="SaveButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="75" Height="23"
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>