<Window x:Class="SimpleLLMChatGUI.ColorsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Colors"
        Height="315"
        Width="360"
        MinHeight="300"
        MinWidth="360"
        MaxWidth="420"
        MaxHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Background="{DynamicResource WindowBackgroundColorBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">

                <!-- ROW TEMPLATE -->
                <!-- Button Text -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Button Text"
                           VerticalAlignment="Center"/>

                    <Button x:Name="ButtonTextColorButton"
                            Grid.Column="1"
                            Content="Choose"
                            Height="23"
                            Margin="0,0,8,0"
                            Click="ButtonTextColorButton_Click"/>

                    <Button x:Name="ClearButtonTextColorButton"
                            Grid.Column="2"
                            Content="Clear"
                            Height="23"
                            Margin="0,0,8,0"
                            Click="ClearButtonTextColorButton_Click"/>

                    <Border x:Name="ButtonTextColorPreview"
                            Grid.Column="3"
                            Width="50"
                            Height="23"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Chat Background -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Chat BG"
                           VerticalAlignment="Center"/>

                    <Button x:Name="ChatBackgroundColorButton"
                            Grid.Column="1"
                            Content="Choose"
                            Height="23"
                            Margin="0,0,8,0"
                            Click="ChatBackgroundColorButton_Click"/>

                    <Button x:Name="ClearChatBackgroundColorButton"
                            Grid.Column="2"
                            Content="Clear"
                            Height="23"
                            Margin="0,0,8,0"
                            Click="ClearChatBackgroundColorButton_Click"/>

                    <Border x:Name="ChatBackgroundColorPreview"
                            Grid.Column="3"
                            Width="50"
                            Height="23"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Chat Text -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Chat Text"
                           VerticalAlignment="Center"/>

                    <Button x:Name="ChatTextColorButton"
                            Grid.Column="1"
                            Content="Choose"
                            Height="23"
                            Margin="0,0,8,0"
                            Click="ChatTextColorButton_Click"/>

                    <Button x:Name="ClearChatTextColorButton"
                            Grid.Column="2"
                            Content="Clear"
                            Height="23"
                            Margin="0,0,8,0"
                            Click="ClearChatTextColorButton_Click"/>

                    <Border x:Name="ChatTextColorPreview"
                            Grid.Column="3"
                            Width="50"
                            Height="23"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Code Block BG -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Code Block BG"
                           VerticalAlignment="Center"/>

                    <Button x:Name="CodeBlockBackgroundColorButton"
                            Grid.Column="1"
                            Content="Choose"
                            Height="23"
                            Margin="0,0,8,0"
                            Click="CodeBlockBackgroundColorButton_Click"/>

                    <Button x:Name="ClearCodeBlockBackgroundColorButton"
                            Grid.Column="2"
                            Content="Clear"
                            Height="23"
                            Margin="0,0,8,0"
                            Click="ClearCodeBlockBackgroundColorButton_Click"/>

                    <Border x:Name="CodeBlockBackgroundColorPreview"
                            Grid.Column="3"
                            Width="50"
                            Height="23"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Label Text -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Label Text"
                           VerticalAlignment="Center"/>

                    <Button x:Name="LabelTextColorButton"
                            Grid.Column="1"
                            Content="Choose"
                            Height="23"
                            Margin="0,0,8,0"
                            Click="LabelTextColorButton_Click"/>

                    <Button x:Name="ClearLabelTextColorButton"
                            Grid.Column="2"
                            Content="Clear"
                            Height="23"
                            Margin="0,0,8,0"
                            Click="ClearLabelTextColorButton_Click"/>

                    <Border x:Name="LabelTextColorPreview"
                            Grid.Column="3"
                            Width="50"
                            Height="23"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Window BG -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Window BG"
                           VerticalAlignment="Center"/>

                    <Button x:Name="WindowBackgroundColorButton"
                            Grid.Column="1"
                            Content="Choose"
                            Height="23"
                            Margin="0,0,8,0"
                            Click="WindowBackgroundColorButton_Click"/>

                    <Button x:Name="ClearWindowBackgroundColorButton"
                            Grid.Column="2"
                            Content="Clear"
                            Height="23"
                            Margin="0,0,8,0"
                            Click="ClearWindowBackgroundColorButton_Click"/>

                    <Border x:Name="WindowBackgroundColorPreview"
                            Grid.Column="3"
                            Width="50"
                            Height="23"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            VerticalAlignment="Center"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="SaveButton"
                    Content="OK"
                    Width="75"
                    Height="23"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click"
                    IsDefault="True"/>

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="75"
                    Height="23"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
