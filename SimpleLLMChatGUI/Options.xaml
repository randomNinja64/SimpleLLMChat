<Window x:Class="SimpleLLMChatGUI.Options"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Title="Options" Height="460" Width="580"
            MinHeight="460" MinWidth="580" MaxWidth="625" MaxHeight="600"
            WindowStartupLocation="CenterOwner"
            ResizeMode="CanResize"
            Loaded="Window_Loaded"
            Background="{DynamicResource WindowBackgroundColorBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Category ListBox -->
        <ListBox x:Name="CategoryListBox"
                 Grid.Row="0" Grid.Column="0"
                 Margin="0,0,8,10"
                 SelectedIndex="0"
                 Foreground="{x:Static SystemColors.ControlTextBrush}"
                 SelectionChanged="CategoryListBox_SelectionChanged">
            <ListBoxItem Content="Appearance"/>
            <ListBoxItem Content="RAG"/>
            <ListBoxItem Content="System"/>
            <ListBoxItem Content="Tools"/>
        </ListBox>

        <!-- Right side: page panels stacked in same cell, shown by category selection -->
        <Grid x:Name="ContentGrid" Grid.Row="0" Grid.Column="1">

            <!-- Appearance page -->
            <ScrollViewer x:Name="AppearancePage" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,0,8,0">

                    <Label Content="Appearance" FontWeight="Bold" FontSize="14" Margin="0,0,0,0"/>

                    <!-- Assistant Name -->
                    <Label Content="Assistant Name:"/>
                    <TextBox x:Name="AssistantNameTextBox"
                             Text="{Binding AssistantName, UpdateSourceTrigger=PropertyChanged}"
                             Height="23"/>

                    <!-- Code Block Font -->
                    <Label Content="Code Block Font:"/>
                    <ComboBox x:Name="CustomCodeFontComboBox"
                              ItemsSource="{Binding SystemFonts}"
                              SelectedItem="{Binding CodeFontFamily, UpdateSourceTrigger=PropertyChanged}"
                              Height="23"/>

                    <!-- Font -->
                    <Label Content="Font:"/>
                    <ComboBox x:Name="CustomFontComboBox"
                              ItemsSource="{Binding SystemFonts}"
                              SelectedItem="{Binding CustomFontFamily, UpdateSourceTrigger=PropertyChanged}"
                              Height="23"/>

                    <!-- Font Size -->
                    <Label Content="Font Size:"/>
                    <TextBox x:Name="FontSizeTextBox"
                             Text="{Binding ChatFontSize, UpdateSourceTrigger=PropertyChanged}"
                             Height="23"/>

                    <!-- Colors -->
                    <Label Content="Colors:"/>
                    <Button x:Name="ChooseColorsButton"
                            Content="Choose Colors..."
                            Height="23"
                            HorizontalAlignment="Left"
                            Width="120"
                            Click="ChooseColorsButton_Click"/>

                    <Label Content="Markdown:"/>
                    <CheckBox x:Name="MarkdownParsingCheckBox"
                              Content="Enable Markdown Parsing"
                              IsChecked="{Binding MarkdownParsing, UpdateSourceTrigger=PropertyChanged}"
                              Height="23"
                              VerticalContentAlignment="Center"/>

                    <Label Content="Thinking display:"/>
                    <ComboBox x:Name="ThinkingDisplayComboBox"
                              ItemsSource="{Binding DisplayModeOptions}"
                              SelectedItem="{Binding ThinkingDisplayModeText, UpdateSourceTrigger=PropertyChanged}"
                              Height="23"
                              HorizontalAlignment="Left"
                              Width="160"/>

                    <Label Content="Tool call display:"/>
                    <ComboBox x:Name="ToolCallDisplayComboBox"
                              ItemsSource="{Binding DisplayModeOptions}"
                              SelectedItem="{Binding ToolCallDisplayModeText, UpdateSourceTrigger=PropertyChanged}"
                              Height="23"
                              HorizontalAlignment="Left"
                              Width="160"/>

                    <Label Content="Tool output display:"/>
                    <ComboBox x:Name="ToolOutputDisplayComboBox"
                              ItemsSource="{Binding DisplayModeOptions}"
                              SelectedItem="{Binding ToolOutputDisplayModeText, UpdateSourceTrigger=PropertyChanged}"
                              Height="23"
                              HorizontalAlignment="Left"
                              Width="160"/>

                </StackPanel>
            </ScrollViewer>

            <!-- System page -->
            <ScrollViewer x:Name="SystemPage" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="8,0,8,0">

                    <Label Content="System" FontWeight="Bold" FontSize="14" Margin="0,0,0,0"/>

                    <!-- API Key -->
                    <Label Content="API Key:"/>
                    <PasswordBox x:Name="ApiKeyPasswordBox" Height="23"/>

                    <!-- Host -->
                    <Label Content="LLM Server URL (http://ip:port):"/>
                    <TextBox x:Name="ServerTextBox"
                             Text="{Binding ServerURL, UpdateSourceTrigger=PropertyChanged}"
                             Height="23"/>

                    <!-- Model -->
                    <Label Content="Model:"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ModelTextBox"
                                 Grid.Column="0"
                                 Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                 Height="23"
                                 Margin="0,0,6,0"/>
                        <Button Grid.Column="1"
                                Content="Model List"
                                Width="80"
                                Height="23"
                                Click="ModelListButton_Click"/>
                    </Grid>

                    <!-- System Prompt -->
                    <Label Content="System Prompt:"/>
                    <TextBox x:Name="SysPromptTextBox"
                             Text="{Binding SysPrompt, UpdateSourceTrigger=PropertyChanged}"
                             Height="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                    <!-- Context Window Size -->
                    <Label Content="Context Window Size (tokens):"/>
                    <TextBox x:Name="ContextWindowSizeTextBox"
                             Text="{Binding ContextWindowSize, UpdateSourceTrigger=PropertyChanged}"
                             Height="23"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Tools page -->
            <ScrollViewer x:Name="ToolsPage" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="8,0,8,0">

                    <Label Content="Tools" FontWeight="Bold" FontSize="14" Margin="0,0,0,0"/>

                    <!-- Tools -->
                    <Label Content="Tools:"/>
                    <ListBox x:Name="ToolsListBox"
                             ItemsSource="{Binding AvailableTools}"
                             ItemTemplate="{StaticResource MultiSelectListBoxItemTemplate}"
                             SelectionMode="Multiple"
                             Foreground="{x:Static SystemColors.ControlTextBrush}"
                             Height="100"/>

                    <!-- Tools Requiring Approval -->
                    <Label Content="Tools Requiring Approval:" Margin="0,0,0,0"/>
                    <ListBox x:Name="ToolsRequiringApprovalListBox"
                             ItemsSource="{Binding AvailableTools}"
                             ItemTemplate="{StaticResource MultiSelectListBoxItemTemplate}"
                             SelectionMode="Multiple"
                             Foreground="{x:Static SystemColors.ControlTextBrush}"
                             Height="100"/>

                </StackPanel>
            </ScrollViewer>

            <!-- RAG page -->
            <ScrollViewer x:Name="RagPage" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="8,0,8,0">

                    <Label Content="RAG" FontWeight="Bold" FontSize="14" Margin="0,0,0,0"/>

                    <CheckBox x:Name="RagEnabledCheckBox"
                              Content="Enable Auto-RAG"
                              IsChecked="{Binding RagEnabled, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,10,0,8"/>

                    <Label Content="Allowed File Extensions (comma-separated):"/>
                    <TextBox x:Name="RagAllowedExtensionsTextBox"
                             Text="{Binding RagAllowedExtensions, UpdateSourceTrigger=PropertyChanged}"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                    <Label Content="Chunk Overlap (lines):"/>
                    <TextBox x:Name="IndexChunkOverlapTextBox"
                             Text="{Binding IndexChunkOverlap, UpdateSourceTrigger=PropertyChanged}"
                             Height="23"/>

                    <Label Content="Chunk Size (lines):"/>
                    <TextBox x:Name="IndexChunkLinesTextBox"
                             Text="{Binding IndexChunkLines, UpdateSourceTrigger=PropertyChanged}"
                             Height="23"/>

                    <Label Content="Embeddings API Key (optional, blank = API key):"/>
                    <PasswordBox x:Name="EmbeddingsApiKeyPasswordBox" Height="23"/>

                    <Label Content="Embeddings Endpoint (optional, blank = LLM server):"/>
                    <TextBox x:Name="EmbeddingsEndpointTextBox"
                             Text="{Binding EmbeddingsEndpoint, UpdateSourceTrigger=PropertyChanged}"
                             Height="23"/>

                    <Label Content="Embeddings Model:"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EmbeddingsModelTextBox"
                                 Grid.Column="0"
                                 Text="{Binding EmbeddingsModel, UpdateSourceTrigger=PropertyChanged}"
                                 Height="23"
                                 Margin="0,0,6,0"/>
                        <Button Grid.Column="1"
                                Content="Model List"
                                Width="80"
                                Height="23"
                                Click="EmbeddingsModelListButton_Click"/>
                    </Grid>

                    <Label Content="Knowledge Folder (Default: &quot;knowledge&quot; next to EXE):"/>
                    <TextBox x:Name="RagKnowledgePathTextBox"
                             Text="{Binding RagKnowledgePath, UpdateSourceTrigger=PropertyChanged}"
                             Height="23"/>

                    <Label Content="Max Snippet Length (chars):"/>
                    <TextBox x:Name="RagMaxSnippetLengthTextBox"
                             Text="{Binding RagMaxSnippetLength, UpdateSourceTrigger=PropertyChanged}"
                             Height="23"/>

                    <Label Content="Results per Retrieve:"/>
                    <TextBox x:Name="RagMaxResultsTextBox"
                             Text="{Binding RagMaxResults, UpdateSourceTrigger=PropertyChanged}"
                             Height="23"/>

                    <Label Content="Retrieve For:"/>
                    <ComboBox x:Name="RagRetrieveModeComboBox" Height="23">
                        <ComboBoxItem Content="New Chat"/>
                        <ComboBoxItem Content="Every Turn"/>
                    </ComboBox>

                    <Label Content="Status:" FontWeight="Bold" Margin="0,14,0,4"/>
                    <TextBlock x:Name="IndexingStatusBrief"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource LabelTextColorBrush}"
                               Text="Index: (unknown)"/>
                    <TextBlock x:Name="IndexingStatusDetail"
                               TextWrapping="Wrap"
                               Margin="0,4,0,8"
                               Foreground="{DynamicResource LabelTextColorBrush}"
                               Text=""/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="BuildIndexButton" Content="Index Now" Width="90" Height="23"
                                Margin="0,0,8,0" Click="BuildIndexButton_Click"/>
                        <Button x:Name="ClearIndexButton" Content="Clear Index" Width="90" Height="23"
                                Click="ClearIndexButton_Click"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="OK" Width="75" Height="23"
                        Margin="0,0,8,0" Click="SaveButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="75" Height="23"
                        Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
