<Window x:Class="SimpleLLMChatGUI.ModelChooserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Model"
        Height="280"
        Width="320"
        MinHeight="240"
        MinWidth="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundColorBrush}"
        ContentRendered="Window_ContentRendered">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText"
                   Grid.Row="0"
                   Text="Loading models..."
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource LabelTextColorBrush}"/>

        <ListBox x:Name="ModelsListBox"
                 Grid.Row="1"
                 Foreground="{x:Static SystemColors.ControlTextBrush}"
                 MouseDoubleClick="ModelsListBox_MouseDoubleClick"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="75"
                    Height="23"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="OkButton_Click"/>
            <Button Content="Cancel"
                    Width="75"
                    Height="23"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
